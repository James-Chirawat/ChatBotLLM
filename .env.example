# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง (ห้าม commit .env.local หรือ .env ขึ้น git)
# ทุกค่าอยู่ฝั่งเซิร์ฟเวอร์เท่านั้น ห้ามตั้งชื่อขึ้นต้นด้วย NEXT_PUBLIC_

# LINE Developers Console > Basic settings / Messaging API (จำเป็นต้องมี)
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=

# Alibaba Cloud Model Studio / DashScope (จำเป็นต้องมี)
QWEN_API_KEY=
# ไม่บังคับ: ชื่อโมเดล (ค่าเริ่มต้น qwen3.8-flash)
QWEN_MODEL=qwen3.8-flash
# ไม่บังคับ: ต้องเป็น endpoint ภูมิภาคเดียวกับ API key และต้องเป็น HTTPS
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# ไม่บังคับ: ตั้งเป็น false เพื่อปิด web search (ค่าเริ่มต้นเปิด)
QWEN_ENABLE_WEB_SEARCH=true

# ไม่บังคับ: ข้อมูลองค์กรที่ต่อท้าย system prompt เช่น เวลาทำการ หรือช่องทางติดต่อ (ห้ามใส่ข้อมูลลับ)
BOT_INSTRUCTIONS=
